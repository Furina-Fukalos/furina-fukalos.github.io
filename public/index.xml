      <description>
        <![CDATA[<h1>我的安全资讯页</h1><p>作者：stacey（1587253748@qq.com）</p>
        
          <p>这里是正文。</p>
<h2 id="友情订阅安全论坛动态">
<a class="header-anchor" href="#%e5%8f%8b%e6%83%85%e8%ae%a2%e9%98%85%e5%ae%89%e5%85%a8%e8%ae%ba%e5%9d%9b%e5%8a%a8%e6%80%81"></a>
友情订阅：安全论坛动态
</h2>
<div id="external-rss-container">
  <p>正在加载安全资讯...</p>
</div>

<script>
(function() {
  
  var workerUrl = "https://butian-rss-proxy.1587253748.workers.dev/"; 
  
  var container = document.getElementById("external-rss-container");
  if (!container) return;

  var itemsPerPage = 5; 
  var allItems = [];    
  var currentPage = 1;  

  
  function renderPage(page) {
    var totalPages = Math.ceil(allItems.length / itemsPerPage);
    if (page < 1) page = 1;
    if (page > totalPages) page = totalPages;
    currentPage = page;

    var start = (page - 1) * itemsPerPage;
    var end = start + itemsPerPage;
    var pageItems = allItems.slice(start, end);

    
    var html = '<ul class="external-rss-list">';
    pageItems.forEach(function(item) {
      var pubDate = item.pubDate || "";
      var dateStr = pubDate ? new Date(pubDate).toISOString().split('T')[0] : "";
      html += '<li class="external-rss-item">'
        + '<a href="' + item.link + '" target="_blank" rel="noopener">' + item.title + '</a>'
        + '<span class="external-rss-date">' + dateStr + '</span>'
        + '</li>';
    });
    html += '</ul>';

    
    if (totalPages > 1) {
      html += '<div class="external-rss-pagination">';
      
      
      if (page > 1) {
        html += '<a href="javascript:void(0)" onclick="window.externalRssChangePage(' + (page - 1) + ')" class="page-btn">上一页</a>';
      } else {
        html += '<span class="page-btn disabled">上一页</span>';
      }

      
      html += '<span class="page-info">' + page + ' / ' + totalPages + '</span>';

      
      if (page < totalPages) {
        html += '<a href="javascript:void(0)" onclick="window.externalRssChangePage(' + (page + 1) + ')" class="page-btn">下一页</a>';
      } else {
        html += '<span class="page-btn disabled">下一页</span>';
      }

      html += '</div>';
    }

    container.innerHTML = html;
  }

  
  window.externalRssChangePage = function(page) {
    renderPage(page);
  };

  
  fetch(workerUrl)
    .then(function(res) {
      if (!res.ok) throw new Error("Network error");
      return res.text();
    })
    .then(function(str) {
      var parser = new DOMParser();
      var xmlDoc = parser.parseFromString(str, "text/xml");
      var items = xmlDoc.querySelectorAll("item");
      
      if (items.length === 0) {
        container.innerHTML = "<p>暂无订阅内容。</p>
        
        <hr><p>本文2026-10-09首发于<a href='http://localhost:1313/'>CTF 新手学习</a>，最后修改于2026-10-09</p>]]>
      </description>
      
    </item>
    
    

